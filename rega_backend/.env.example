APP_NAME="REGA Backend"
APP_ENV=local
APP_KEY=base64:5ZA6F0Uc1NGHAetgQKrItRMmoH5vCggEEzoHdoowvyI=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=ku
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rega_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password-reset OTP (and future SMS) — POST JSON { phone, message, type } to this URL.
# Leave empty in production: OTPs are generated but not delivered (see storage/logs).
# REGA_SMS_WEBHOOK_URL=https://your-sms-bridge.example/send
# REGA_SMS_OTP_TEMPLATE="کۆدی نوێکردنەوەی هەژمار REGA: {otp}"

# Firebase Cloud Messaging (customer lock-screen push)
# Download service account JSON from Firebase Console → Project settings → Service accounts
# FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json
# FCM_PROJECT_ID=your-firebase-project-id
